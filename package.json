{
  "name": "roam-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "audit:dataset": "vite-node scripts/audit-dataset.ts",
    "audit:dataset:check": "vite-node scripts/audit-dataset.ts -- --check",
    "audit:gates": "vite-node scripts/audit-dataset.ts -- --gates",
    "catalog:verify": "vite-node scripts/verify-candidates.ts --",
    "catalog:recheck-file": "vite-node scripts/make-recheck-batch.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vite-node": "2.1.9",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
